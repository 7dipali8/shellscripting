GRUB_DISABLE_SUBMENU=true
GRUB_TERMINAL_OUTPUT="console"
GRUB_CMDLINE_LINUX="crashkernel=2G-64G:256M,64G-:512M resume=UUID=763c68db-1f81-4f70-9d5f-cd4310c8271b rd.lvm.lv=rhel_vbox/root rd.lvm.lv=rhel_vbox/swap rhgb quiet"
GRUB_DISABLE_RECOVERY="true"
GRUB_ENABLE_BLSCFG=true
